[Unit]
Description=Back up RunningHub data

[Service]
Type=oneshot
User=runninghub
Group=runninghub
WorkingDirectory=/opt/runninghub
Environment=RUNNINGHUB_APP_DIR=/opt/runninghub
Environment=RUNNINGHUB_BACKUP_DIR=/var/backups/runninghub
ExecStart=/bin/bash /opt/runninghub/deploy/scripts/backup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/runninghub/data /var/backups/runninghub

[Unit]
Description=RunningHub MiniMax audio task worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rhvideo
Group=rhvideo
WorkingDirectory=/opt/runninghub-video
EnvironmentFile=/opt/runninghub-video/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/runninghub-video/.venv/bin/python -m app.workers.audio_worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
CPUQuota=50%
CPUWeight=10
IOWeight=10
Nice=15
MemoryHigh=768M
MemoryMax=1536M
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/runninghub-video/data

[Install]
WantedBy=multi-user.target

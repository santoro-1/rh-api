[Unit]
Description=RunningHub isolated FunASR service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rhvideo
Group=rhvideo
WorkingDirectory=/opt/runninghub-video
EnvironmentFile=/opt/runninghub-video/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/opt/runninghub-video/data/asr-home
Environment=XDG_CACHE_HOME=/opt/runninghub-video/data/asr-home/.cache
Environment=MODELSCOPE_CACHE=/opt/runninghub-video/data/asr-models
Environment=HF_HOME=/opt/runninghub-video/data/asr-home/huggingface
Environment=TORCH_HOME=/opt/runninghub-video/data/asr-home/torch
Environment=ASR_DEVICE=cpu
Environment=OMP_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
ExecStart=/opt/runninghub-video/.asr-runtime/venv/bin/python -m uvicorn asr_service.app:app --host 127.0.0.1 --port 18084 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30
CPUQuota=150%
CPUWeight=10
IOWeight=10
Nice=15
MemoryHigh=2048M
MemoryMax=2560M
TasksMax=128
OOMScoreAdjust=500
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/runninghub-video/data

[Install]
WantedBy=multi-user.target

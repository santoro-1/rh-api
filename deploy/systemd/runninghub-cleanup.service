[Unit]
Description=Clean expired RunningHub uploads and outputs
After=runninghub-web.service

[Service]
Type=oneshot
User=runninghub
Group=runninghub
WorkingDirectory=/opt/runninghub
EnvironmentFile=/opt/runninghub/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/runninghub/.venv/bin/python -m scripts.cleanup_files
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/runninghub/data

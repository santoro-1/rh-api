[Unit]
Description=RunningHub video task worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=runninghub
Group=runninghub
WorkingDirectory=/opt/runninghub
EnvironmentFile=/opt/runninghub/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/runninghub/.venv/bin/python -m app.workers.task_worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/runninghub/data

[Install]
WantedBy=multi-user.target

+class NativePipeTests(unittest.TestCase):
+    def api(self):
+        kernel, advapi, ovapi = Mock(), Mock(), Mock()
+        kernel.CreateNamedPipeW.return_value = 88
+        kernel.CreateFileW.return_value = 99

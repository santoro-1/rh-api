+class Response:
+    status = 200
+    def __init__(self, data):
+        self.stream = io.BytesIO(data if isinstance(data, bytes) else json.dumps(data).encode())
+        self.headers = {}
+    def read(self, *args):
+        return self.stream.read(*args)
+    def __enter__(self):
+        return self
+    def __exit__(self, *args):
+        pass

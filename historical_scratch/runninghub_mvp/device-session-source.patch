+                        self.cache_warning = False
+                    except OSError:
+                        # Cache is optional; do not discard valid online authorization.
+                        self.cache_warning = True
+                return self.summary()
+            except (DeviceAuthorizationError, DeviceIdentityError) as exc:
+                self._failed(exc)

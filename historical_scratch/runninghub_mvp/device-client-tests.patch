+class Identity:
+    def __init__(self, signer=None):
+        self.signer = signer
+        self.created = 0
+
+    def open_existing(self):
+        return self.signer
+
+    def initialize_for_activation(self, **_):
+        if self.signer is None:
+            self.signer = Signer()
+            self.created += 1
+        return self.signer

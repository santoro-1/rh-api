+class Clock:
+    def __init__(self):
+        self.wall, self.mono = 1700000000.0, 100.0
+
+    def advance(self, seconds):
+        self.wall += seconds
+        self.mono += seconds
+
+
+def jwk(key):
+    numbers = key.public_key().public_numbers()
+    return {"kty": "EC", "crv": "P-256", "x": b64url(numbers.x.to_bytes(32, "big")), "y": b64url(numbers.y.to_bytes(32, "big"))}
+
+
+class Signer:
+    protection = "tpm"
+
+    def __init__(self):
+        self.key = ec.generate_private_key(ec.SECP256R1())
+        self.public_jwk = jwk(self.key)
+        self.thumbprint = jwk_thumbprint(self.public_jwk)
+        self.closed = False
+
+    def sign(self, message):
+        if self.closed:
+            raise DeviceIdentityError("KEY_UNAVAILABLE", "test key unavailable")
+        r, s = utils.decode_dss_signature(self.key.sign(message, ec.ECDSA(hashes.SHA256())))
+        return r.to_bytes(32, "big") + s.to_bytes(32, "big")
+
+    def close(self):
+        self.closed = True
+

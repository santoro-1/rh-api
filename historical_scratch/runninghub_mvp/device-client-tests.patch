+class Transport:
+    def __init__(self, issuer):
+        self.issuer = issuer
+        self.error = None
+        self.calls = []
+
+    def request(self, **request):
+        self.calls.append(request)
+        if self.error:
+            raise self.error
+        if request["path"].endswith("/challenge"):
+            return {"nonce": secrets.token_urlsafe(32), "expires_in": 120}
+        if request["path"].endswith("/register"):
+            self.issuer.signer = SignerFromJwkNotNeeded  # registration response only; no keys get created here
+        return self.issuer.credentials()

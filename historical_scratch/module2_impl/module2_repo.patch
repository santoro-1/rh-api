+    def test_profile_weights_and_hard_filters_cannot_drift(self) -> None:
+        self.assertEqual(sum(MUSIC_MATCHER_WEIGHTS_V1.values()), 100)
+        self.assertEqual(
+            MUSIC_MATCHER_WEIGHTS_V1,
+            {

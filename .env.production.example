# 复制为 /opt/runninghub-video/.env 后再填写。不要提交真实密钥。
APP_ENV=production
APP_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
APP_ENCRYPTION_KEY=replace-with-a-valid-fernet-key
ALLOWED_HOSTS=video.example.com

DATABASE_URL=sqlite:////opt/runninghub-video/data/app.db
DATA_DIR=/opt/runninghub-video/data

RUNNINGHUB_BASE_URL=https://www.runninghub.cn
DEFAULT_RUNNINGHUB_AI_APP_ID=2062251097452007426
DEFAULT_RUNNINGHUB_INSTANCE_TYPE=default
DEFAULT_USE_PERSONAL_QUEUE=false

POLL_INTERVAL_SECONDS=5
RUNNINGHUB_REMOTE_WATCHDOG_SECONDS=14400
RUNNINGHUB_AUTO_RETRY_LIMIT=3
RUNNINGHUB_AUTO_RETRY_BASE_DELAY_SECONDS=60

MAX_IMAGE_SIZE_MB=200
MAX_AUDIO_SIZE_MB=100
MAX_VIDEO_SIZE_MB=500
UPLOAD_RETENTION_DAYS=2
OUTPUT_RETENTION_DAYS=7
COOKIE_SECURE=true
LOGIN_RATE_LIMIT_PER_MINUTE=10
TASK_CREATE_RATE_LIMIT_PER_MINUTE=10
MAX_BATCH_ITEMS=50
MAX_BATCH_TOTAL_UPLOAD_MB=5120
STAGED_ASSET_RETENTION_HOURS=24
MINIMAX_DEFAULT_BASE_URL=https://api.minimaxi.com
MINIMAX_REQUEST_TIMEOUT_SECONDS=120
TEMPORARY_VOICE_RETENTION_HOURS=48
LONG_AUDIO_ALIGNMENT_PROVIDER=funasr_http
ASR_BASE_URL=http://127.0.0.1:18084
ASR_SHARED_TOKEN=
ASR_REQUEST_TIMEOUT_SECONDS=1800
MEDIA_PROCESSING_MODE=remote
MEDIA_WORKER_TOKEN=replace-with-a-separate-random-worker-token
MEDIA_WORKER_LEASE_SECONDS=1800
MEDIA_WORKER_ARCHIVE_LIMIT_MB=500
LOG_RETENTION_DAYS=7
LOG_MAX_BYTES=10485760

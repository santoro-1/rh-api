APP_ENV=development
APP_SECRET_KEY=change-this-to-a-long-random-secret
APP_ENCRYPTION_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# 留空时设备凭据签发明确不可用；禁止复用 APP_SECRET_KEY 或临时测试密钥。
WORKBENCH_DEVICE_AUTH_ORIGIN=
WORKBENCH_DEVICE_AUTH_KEY_ID=
WORKBENCH_DEVICE_AUTH_PRIVATE_KEY_FILE=
WORKBENCH_DEVICE_AUTH_PUBLIC_KEYS_FILE=

DATABASE_URL=sqlite:///./data/app.db
DATA_DIR=./data

RUNNINGHUB_BASE_URL=https://www.runninghub.cn
DEFAULT_RUNNINGHUB_AI_APP_ID=2062251097452007426
DEFAULT_RUNNINGHUB_INSTANCE_TYPE=plus
DEFAULT_USE_PERSONAL_QUEUE=false

POLL_INTERVAL_SECONDS=5
RUNNINGHUB_REMOTE_WATCHDOG_SECONDS=14400
RUNNINGHUB_AUTO_RETRY_LIMIT=3
RUNNINGHUB_AUTO_RETRY_BASE_DELAY_SECONDS=60
RUNNINGHUB_DUAL_POOL_ENABLED=false
# 工作台灰度开关：true 时 H3 成功视频不落盘到本服务，JYD 直接从 RunningHub 返回地址下载。
H3_DIRECT_DELIVERY_ENABLED=false
# 生产开启直达前必须填写实际观测并审核过的 RunningHub/COS 域名后缀。
H3_PROVIDER_ALLOWED_HOSTS=runninghub.cn,runninghub.ai,myqcloud.com,tencentcos.cn

MAX_IMAGE_SIZE_MB=200
MAX_AUDIO_SIZE_MB=100
MAX_VIDEO_SIZE_MB=500
UPLOAD_RETENTION_DAYS=2
OUTPUT_RETENTION_DAYS=7
COOKIE_SECURE=false
LOGIN_RATE_LIMIT_PER_MINUTE=10
TASK_CREATE_RATE_LIMIT_PER_MINUTE=10
MAX_BATCH_ITEMS=50
MAX_BATCH_TOTAL_UPLOAD_MB=5120
STAGED_ASSET_RETENTION_HOURS=24
MINIMAX_DEFAULT_BASE_URL=https://api.minimaxi.com
MINIMAX_REQUEST_TIMEOUT_SECONDS=120
ARK_REQUEST_MANAGER_ENABLED=false
ARK_MAX_CONCURRENCY=10
ARK_QUEUE_MAX=200
ARK_ANALYSIS_TOTAL_TIMEOUT_SECONDS=540
ARK_QUEUE_WAIT_TIMEOUT_SECONDS=120
ARK_CONNECT_TIMEOUT_SECONDS=10
ARK_PLANNING_MAX_ATTEMPTS=2
ARK_CIRCUIT_BREAKER_ENABLED=true
ARK_LIMITER_SCOPE=process
CONTENT_ANALYSIS_MAX_SCRIPT_CHARS=50000
TEMPORARY_VOICE_RETENTION_HOURS=48
LONG_AUDIO_ALIGNMENT_PROVIDER=funasr_http
ASR_BASE_URL=http://127.0.0.1:18084
ASR_SHARED_TOKEN=
ASR_REQUEST_TIMEOUT_SECONDS=1800
MEDIA_PROCESSING_MODE=local
MEDIA_WORKER_TOKEN=
MEDIA_WORKER_LEASE_SECONDS=1800
MEDIA_WORKER_ARCHIVE_LIMIT_MB=500
LOG_RETENTION_DAYS=7
LOG_MAX_BYTES=10485760

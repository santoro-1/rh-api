# 服务器主站地址。媒体节点只主动访问该 HTTPS 地址，不需要开放入站端口。
MEDIA_WORKER_SERVER_URL=https://video.lanyingjk01.com

# 必须与服务器 .env 中的 MEDIA_WORKER_TOKEN 完全一致，至少 32 个字符。
MEDIA_WORKER_TOKEN=replace-with-the-same-random-worker-token

# 留空时自动使用“电脑名-media”，多台节点可以直接区分；也可手动指定。
MEDIA_WORKER_ID=
MEDIA_WORKER_POLL_SECONDS=10
MEDIA_WORKER_HEARTBEAT_SECONDS=60
MEDIA_WORKER_WORK_DIR=./data

# ASR 仍只监听本机回环地址。CPU 版不会占用现有 GPU ASR 的显存。
ASR_BASE_URL=http://127.0.0.1:18084
ASR_HOST=127.0.0.1
ASR_PORT=18084
ASR_SHARED_TOKEN=
ASR_REQUEST_TIMEOUT_SECONDS=1800
ASR_DEVICE=cpu
